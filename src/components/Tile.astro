---
/**
 * Illustrated Nasrid soap tiles (pure SVG). Variants: star | knot | sebka | dish
 */
interface Props { variant?: 'star' | 'knot' | 'sebka' | 'dish'; size?: number | string; class?: string; shadow?: boolean }
const { variant = 'star', size = 200, class: cls = '', shadow = true } = Astro.props;

// eight-pointed star = two squares rotated 45°
const sq = (r: number) => `M${50 - r} ${50 - r} H${50 + r} V${50 + r} H${50 - r} Z`;
const dia = (r: number) => `M50 ${50 - r * 1.4142} L${50 + r * 1.4142} 50 L50 ${50 + r * 1.4142} L${50 - r * 1.4142} 50 Z`;
const oct = 'M31 8 H69 L92 31 V69 L69 92 H31 L8 69 V31 Z';
const hex = 'M50 6 L88 28 V72 L50 94 L12 72 V28 Z';
---
<svg class={`tile ${cls}`} width={size} height={size} viewBox="0 0 100 100" aria-hidden="true" data-variant={variant}>
  <defs>
    <linearGradient id={`soap-${variant}`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#fffdf7"/>
      <stop offset="1" stop-color="#ebe3d0"/>
    </linearGradient>
    <filter id="tile-shadow" x="-20%" y="-20%" width="140%" height="150%">
      <feDropShadow dx="0" dy="6" stdDeviation="4" flood-color="#0d1538" flood-opacity=".35"/>
    </filter>
  </defs>

  {variant === 'star' && (
    <g filter={shadow ? 'url(#tile-shadow)' : undefined}>
      <path d={oct} fill={`url(#soap-${variant})`} stroke="#d8cfb8" stroke-width=".8"/>
      <path d={sq(24)} fill="#1d2f7c"/><path d={dia(24)} fill="#1d2f7c"/>
      <path d={sq(15)} fill="#f7f2e8"/><path d={dia(15)} fill="#f7f2e8"/>
      <path d={sq(7)} fill="#c9862b"/><path d={dia(7)} fill="#c9862b"/>
      <g fill="#2e6a4e">
        <circle cx="14" cy="14" r="3.2"/><circle cx="86" cy="14" r="3.2"/><circle cx="86" cy="86" r="3.2"/><circle cx="14" cy="86" r="3.2"/>
      </g>
      <g fill="#1d2f7c" opacity=".9">
        <path d="M50 8 l4 6 h-8z"/><path d="M50 92 l4 -6 h-8z"/><path d="M8 50 l6 4 v-8z"/><path d="M92 50 l-6 4 v-8z"/>
      </g>
    </g>
  )}

  {variant === 'knot' && (
    <g filter={shadow ? 'url(#tile-shadow)' : undefined}>
      <path d={hex} fill={`url(#soap-${variant})`} stroke="#d8cfb8" stroke-width=".8"/>
      <g fill="none" stroke-linecap="round" stroke-linejoin="round">
        <path d="M50 22 C 66 30, 72 44, 62 58 C 54 70, 40 72, 30 62 C 22 52, 28 36, 44 30 C 56 26, 66 34, 70 48" stroke="#2e6a4e" stroke-width="7"/>
        <path d="M50 22 C 66 30, 72 44, 62 58 C 54 70, 40 72, 30 62 C 22 52, 28 36, 44 30 C 56 26, 66 34, 70 48" stroke="#f7f2e8" stroke-width="2.2"/>
        <path d="M50 78 C 34 70, 28 56, 38 42 C 46 30, 60 28, 70 38 C 78 48, 72 64, 56 70 C 44 74, 34 66, 30 52" stroke="#c9862b" stroke-width="7"/>
        <path d="M50 78 C 34 70, 28 56, 38 42 C 46 30, 60 28, 70 38 C 78 48, 72 64, 56 70 C 44 74, 34 66, 30 52" stroke="#f7f2e8" stroke-width="2.2"/>
      </g>
      <path d={sq(6)} fill="#1d2f7c"/><path d={dia(6)} fill="#1d2f7c"/>
      <g fill="#1d2f7c"><circle cx="50" cy="13" r="2.4"/><circle cx="50" cy="87" r="2.4"/><circle cx="18" cy="31" r="2.4"/><circle cx="82" cy="31" r="2.4"/><circle cx="18" cy="69" r="2.4"/><circle cx="82" cy="69" r="2.4"/></g>
    </g>
  )}

  {variant === 'sebka' && (
    <g filter={shadow ? 'url(#tile-shadow)' : undefined}>
      <rect x="10" y="10" width="80" height="80" rx="4" fill={`url(#soap-${variant})`} stroke="#d8cfb8" stroke-width=".8"/>
      <g fill="#16161a">
        <path d="M30 14 L46 30 L30 46 L14 30 Z"/><path d="M70 14 L86 30 L70 46 L54 30 Z"/>
        <path d="M30 54 L46 70 L30 86 L14 70 Z"/><path d="M70 54 L86 70 L70 86 L54 70 Z"/>
      </g>
      <g fill="#1d2f7c">
        <path d="M50 34 L66 50 L50 66 L34 50 Z"/>
        <path d="M50 12 L54 16 L50 20 L46 16 Z"/><path d="M50 80 L54 84 L50 88 L46 84 Z"/>
        <path d="M12 50 L16 46 L20 50 L16 54 Z"/><path d="M80 50 L84 46 L88 50 L84 54 Z"/>
      </g>
      <g fill="#f7f2e8">
        <path d="M30 24 L36 30 L30 36 L24 30 Z"/><path d="M70 24 L76 30 L70 36 L64 30 Z"/>
        <path d="M30 64 L36 70 L30 76 L24 70 Z"/><path d="M70 64 L76 70 L70 76 L64 70 Z"/>
      </g>
      <path d={sq(5)} fill="#c9862b"/><path d={dia(5)} fill="#c9862b"/>
    </g>
  )}

  {variant === 'dish' && (
    <g filter={shadow ? 'url(#tile-shadow)' : undefined}>
      <circle cx="50" cy="50" r="44" fill="#fffdf7" stroke="#d8cfb8" stroke-width=".8"/>
      <circle cx="50" cy="50" r="36" fill="none" stroke="#e6dcc6" stroke-width="1"/>
      <circle cx="50" cy="50" r="33" fill="#f4eee0"/>
      <g fill="none" stroke="#d8cfb8" stroke-width="1.2" opacity=".9">
        <path d="M50 30 C 58 38, 62 46, 66 56 C 58 52, 50 52, 40 56 C 42 46, 45 38, 50 30 Z"/>
        <path d="M50 30 C 46 40, 42 50, 34 60 C 44 57, 55 58, 66 56"/>
      </g>
      <text x="50" y="72" text-anchor="middle" font-family="Cormorant Garamond, serif" font-size="5.5" letter-spacing="1.2" fill="#c5a24b">ALHAMBRA SOAP</text>
    </g>
  )}
</svg>
