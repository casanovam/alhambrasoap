---
/** Nasrid eight-point star lattice, used as a faint background layer. */
interface Props { id?: string; color?: string; opacity?: number; class?: string }
const { id = 'nasrid', color = '#c5a24b', opacity = 0.16, class: cls = '' } = Astro.props;
---
<svg class={`pattern ${cls}`} aria-hidden="true" style={`opacity:${opacity}`}>
  <defs>
    <pattern id={id} width="80" height="80" patternUnits="userSpaceOnUse">
      <g fill="none" stroke={color} stroke-width="0.9">
        <path d="M40 4 L52 28 L76 40 L52 52 L40 76 L28 52 L4 40 L28 28 Z"/>
        <path d="M22 22 H58 V58 H22 Z"/>
        <path d="M0 0 L20 20 M80 0 L60 20 M0 80 L20 60 M80 80 L60 60"/>
        <circle cx="40" cy="40" r="5"/>
        <circle cx="0" cy="0" r="6"/><circle cx="80" cy="0" r="6"/><circle cx="0" cy="80" r="6"/><circle cx="80" cy="80" r="6"/>
      </g>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`}/>
</svg>

<style>
  .pattern { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
</style>
