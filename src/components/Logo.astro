---
interface Props { size?: number; wordmark?: boolean; color?: string; class?: string }
const { size = 44, wordmark = true, color = 'currentColor', class: cls = '' } = Astro.props;
---
<span class={`logo ${cls}`} style={`--c:${color}`}>
  <svg width={size} height={size} viewBox="0 0 100 100" fill="none" aria-hidden="true">
    <!-- three interwoven arcs forming the Alhambra Soap triangle -->
    <path d="M50 12 C 68 30, 78 50, 86 72 C 70 62, 50 60, 30 68 C 34 48, 40 28, 50 12 Z" stroke="var(--c)" stroke-width="2.4" stroke-linejoin="round"/>
    <path d="M50 12 C 40 34, 32 54, 14 74 C 36 68, 58 70, 86 72" stroke="var(--c)" stroke-width="2.4" stroke-linecap="round"/>
    <path d="M14 74 C 26 56, 40 40, 50 12" stroke="var(--c)" stroke-width="1.6" stroke-linecap="round" opacity=".7"/>
    <path d="M30 68 C 46 74, 66 76, 86 72" stroke="var(--c)" stroke-width="1.6" stroke-linecap="round" opacity=".7"/>
  </svg>
  {wordmark && (
    <span class="wm">
      <span class="wm-1">Alhambra</span>
      <span class="wm-2">Soap</span>
      <span class="wm-3">Hand made</span>
    </span>
  )}
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.7rem; color: var(--c); line-height: 1; }
  .wm { display: grid; font-family: var(--font-display); }
  .wm-1 { font-size: 1.15rem; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 500; }
  .wm-2 { font-size: 0.9rem; letter-spacing: 0.28em; text-transform: uppercase; margin-top: 0.1rem; }
  .wm-3 { font-family: var(--font-body); font-size: 0.5rem; letter-spacing: 0.3em; text-transform: uppercase; margin-top: 0.28rem; opacity: 0.75; }
</style>
