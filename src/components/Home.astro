---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Tile from './Tile.astro';
import Pattern from './Pattern.astro';
import Doodle from './Doodle.astro';
import { t, INSTAGRAM_URL, INSTAGRAM_DM_URL, INSTAGRAM_HIGHLIGHTS, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);

// All photos live in src/assets/images and go through Astro's image pipeline (AVIF/WebP + srcset).
const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/*.{jpg,jpeg,png}', { eager: true });
const photo = (name: string) => {
  const m = photos[`/src/assets/images/${name}`];
  if (!m) throw new Error(`Missing photo src/assets/images/${name}`);
  return m.default;
};
// Optional portrait of Belén: drop `belen.jpg` into src/assets/images and it appears next to the signature.
const portrait = photos['/src/assets/images/belen.jpg']?.default;

const hand = lang === 'es'
  ? { hero: 'hechos a mano, uno a uno', story: 'recién desmoldada', box: 'lista para regalar', ws: '¡y brunch marroquí!', gallery: 'del taller a tu casa', qr: 'escanéame' }
  : { hero: 'made by hand, one by one', story: 'fresh out of the mould', box: 'ready to gift', ws: 'and Moroccan brunch!', gallery: 'from the workshop to your home', qr: 'scan me' };

const productPhotos = [
  { src: 'estrella-de-los-reyes.jpg', alt: { es: 'Jabón octogonal Estrella de los Reyes, estrella azul con centro ocre', en: 'Octagonal Estrella de los Reyes soap, blue star with ochre centre' } },
  { src: 'pajaritas.jpg', alt: { es: 'Jabón hexagonal Pajaritas con pajaritas nazaríes azules, verdes, ocres y negras', en: 'Hexagonal Pajaritas soap with blue, green, ochre and black Nasrid birds' } },
  { src: 'jabonera.jpg', alt: { es: 'Jabonera redonda de Alhambra Soap sobre terciopelo azul, rodeada de jabones azulejo', en: 'Round Alhambra Soap dish on blue velvet, surrounded by tile soaps' } },
];
const formats = ['avif', 'webp'] as const;
const igIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>`;
const arrow = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`;
---

<!-- ───────────────────────── HERO ───────────────────────── -->
<section class="hero">
  <Pattern id="p-hero" opacity={0.1} />
  <div class="wrap hero-in">
    <div class="hero-copy">
      <span class="eyebrow hero-el" style="--i:0">{d.hero.eyebrow}</span>
      <h1 class="hero-title">
        {d.hero.title.map((line, i) => <span class="hero-el" style={`--i:${i + 1}`}><span class:list={[{ it: i === 2 }]}>{line}</span></span>)}
      </h1>
      <p class="lead hero-el" style="--i:4">{d.hero.lead}</p>
      <div class="hero-cta hero-el" style="--i:5">
        <a class="btn btn-primary" href="#coleccion">{d.hero.cta} <Fragment set:html={arrow} /></a>
        <a class="btn btn-ghost" href={INSTAGRAM_DM_URL} target="_blank" rel="noopener"><Fragment set:html={igIcon} /> {d.hero.ctaSecondary}</a>
      </div>
    </div>

    <div class="hero-art hero-el" style="--i:2">
      <figure class="polaroid hero-photo">
        <Picture src={photo('ritual-caja-abierta.jpg')} alt={d.photos.hero} widths={[480, 800, 1000]} sizes="(min-width: 900px) 520px, 92vw" formats={formats} loading="eager" fetchpriority="high" />
      </figure>
      <div class="hero-note" aria-hidden="true">
        <span class="hand">{hand.hero}</span>
        <Doodle kind="arrow" class="hero-arrow" color="var(--cobalt)" />
      </div>
    </div>
  </div>
</section>

<!-- ───────────────────────── STORY ───────────────────────── -->
<section class="section story" id="historia">
  <div class="wrap story-in">
    <div class="arch reveal">
      <div class="arch-inner">
        <Picture src={photo('estrella-ocho-puntas.jpg')} alt={d.photos.story} widths={[420, 840]} sizes="(min-width: 900px) 420px, 92vw" formats={formats} loading="lazy" />
      </div>
      <div class="arch-frame"></div>
      <span class="hand arch-cap" aria-hidden="true">{hand.story}</span>
    </div>
    <div class="story-copy">
      <span class="eyebrow reveal">{d.story.eyebrow}</span>
      <h2 class="title reveal" data-delay="1">{d.story.title}</h2>
      <p class="lead reveal" data-delay="2">{d.story.p1}</p>
      <p class="lead reveal" data-delay="2">{d.story.p2}</p>
      <ul class="facts reveal" data-delay="3">
        {d.story.facts.map((f) => (
          <li><strong>{f.n}</strong><span>{f.label}</span></li>
        ))}
      </ul>
      <blockquote class="quote reveal" data-delay="3">{d.story.quote}</blockquote>
      <div class="signoff reveal" data-delay="4">
        {portrait && (
          <span class="portrait">
            <Picture src={portrait} alt={d.story.portraitAlt} widths={[160, 320]} sizes="80px" formats={formats} loading="lazy" />
          </span>
        )}
        <div>
          <span class="signature">{d.story.signature}</span>
          <span class="role">{d.story.role}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ───────────────────────── COLLECTION ───────────────────────── -->
<section class="section collection" id="coleccion">
  <Pattern id="p-col" opacity={0.07} color="#1d2f7c" />
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow reveal">{d.collection.eyebrow}</span>
      <h2 class="title reveal" data-delay="1">{d.collection.title}</h2>
      <p class="lead reveal" data-delay="2">{d.collection.intro}</p>
    </div>

    <ul class="products">
      {d.collection.items.map((item, i) => (
        <li class="product reveal" data-delay={String(i + 1)}>
          <div class="product-art">
            <Picture src={photo(productPhotos[i].src)} alt={productPhotos[i].alt[lang]} widths={[360, 720, 900]} sizes="(min-width: 900px) 360px, (min-width: 600px) 45vw, 92vw" formats={formats} loading="lazy" />
          </div>
          <div class="product-body">
            <span class="product-idx">0{i + 1}</span>
            <h3>{item.name}</h3>
            <p>{item.desc}</p>
            <span class="product-note">{item.note}</span>
          </div>
        </li>
      ))}
    </ul>

    <div class="giftbox">
      <div class="giftbox-art">
        <figure class="polaroid giftbox-polaroid reveal">
          <Picture src={photo('ritual-caja-cerrada.jpg')} alt={d.photos.box} widths={[340, 680]} sizes="(min-width: 900px) 340px, 80vw" formats={formats} loading="lazy" />
          <figcaption class="cap hand">{hand.box}</figcaption>
        </figure>
      </div>
      <div class="giftbox-copy">
        <span class="tag reveal">{d.collection.giftBox.tag}</span>
        <h3 class="reveal" data-delay="1">{d.collection.giftBox.name}</h3>
        <p class="reveal" data-delay="2">{d.collection.giftBox.desc}</p>
        <a class="btn btn-gold reveal" data-delay="3" href={INSTAGRAM_DM_URL} target="_blank" rel="noopener">{d.collection.giftBox.cta} <Fragment set:html={arrow} /></a>
      </div>
    </div>

    <p class="price-note reveal">{d.collection.priceNote}</p>

    <div class="gallery-head">
      <span class="eyebrow reveal">{d.gallery.eyebrow}</span>
      <h3 class="reveal" data-delay="1">{d.gallery.title} <span class="hand gold gallery-hand">{hand.gallery}</span></h3>
    </div>
    <ul class="gallery">
      {d.gallery.items.map((g, i) => (
        <li class="reveal polaroid" data-delay={String((i % 3) + 1)} style={`--rot:${[-2, 1.5, -1][i % 3]}deg`}>
          <Picture src={photo(g.img)} alt={g.caption} widths={[320, 640, 900]} sizes="(min-width: 760px) 30vw, 92vw" formats={formats} loading="lazy" />
          <span class="cap hand">{g.caption}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- ───────────────────────── WORKSHOPS ───────────────────────── -->
<section class="section workshops" id="talleres">
  <div class="wrap">
    <div class="ws-grid">
      <div class="ws-copy">
        <span class="eyebrow reveal">{d.workshops.eyebrow}</span>
        <h2 class="title reveal" data-delay="1">{d.workshops.title}</h2>
        <p class="lead reveal" data-delay="2">{d.workshops.intro}</p>
        <ul class="ws-detail reveal" data-delay="3">
          {d.workshops.detail.map((x) => <li>{x}</li>)}
        </ul>
        <div class="ws-cta reveal" data-delay="4">
          <a class="btn btn-primary" href={INSTAGRAM_DM_URL} target="_blank" rel="noopener">{d.workshops.cta} <Fragment set:html={arrow} /></a>
          <span class="hand ws-hand" aria-hidden="true">{hand.ws}</span>
        </div>
      </div>
      <ol class="steps">
        {d.workshops.steps.map((s, i) => (
          <li class="step reveal" data-delay={String(i + 1)}>
            <span class="step-n">{i + 1}</span>
            <div>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<!-- ───────────────────────── GIFTS ───────────────────────── -->
<section class="gifts" id="regalos">
  <Pattern id="p-gift" opacity={0.06} scale={0.5} color="#e3c878" />
  <div class="wrap gifts-in">
    <div class="gifts-tile reveal" aria-hidden="true"><Tile variant="pajaritas" size="100%" /></div>
    <div class="gifts-copy">
      <span class="eyebrow light reveal">{d.gifts.eyebrow}</span>
      <h2 class="title reveal" data-delay="1">{d.gifts.title}</h2>
      <p class="reveal" data-delay="2">{d.gifts.text}</p>
      <a class="btn btn-gold reveal" data-delay="3" href={INSTAGRAM_DM_URL} target="_blank" rel="noopener"><Fragment set:html={igIcon} /> {d.gifts.cta}</a>
    </div>
  </div>
  <div class="wrap">
    <ul class="gifts-more">
      {d.gifts.more.map((g, i) => (
        <li class="reveal" data-delay={String(i + 1)}>
          <h3>{g.t}</h3>
          <p>{g.d}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- ───────────────────────── TESTIMONIALS ───────────────────────── -->
<section class="section testimonials">
  <div class="wrap">
    <div class="sec-head center">
      <span class="eyebrow reveal">{d.testimonials.eyebrow}</span>
      <h2 class="title reveal" data-delay="1">{d.testimonials.title}</h2>
    </div>
    <ul class="quotes">
      {d.testimonials.items.map((q, i) => (
        <li class="q reveal" data-delay={String(i + 1)}>
          <span class="q-mark">“</span>
          <p>{q.q}</p>
          <cite>{q.a}</cite>
        </li>
      ))}
    </ul>
    <p class="t-source reveal">
      <span>{d.testimonials.source}</span>
      <a href={INSTAGRAM_HIGHLIGHTS.testimonios} target="_blank" rel="noopener">{d.testimonials.more} <Fragment set:html={arrow} /></a>
    </p>
  </div>
</section>

<!-- ───────────────────────── PRESS ───────────────────────── -->
<section class="press">
  <div class="wrap">
    <div class="ornament reveal"><span class="eyebrow" style="color:var(--gold-3)">{d.press.eyebrow}</span></div>
    <ul class="press-list reveal" data-delay="1">
      {d.press.items.map((p) => <li>{p}</li>)}
      <li class="press-link"><a href={INSTAGRAM_HIGHLIGHTS.prensa} target="_blank" rel="noopener">{d.press.more} <Fragment set:html={arrow} /></a></li>
    </ul>
  </div>
</section>

<!-- ───────────────────────── CONTACT ───────────────────────── -->
<section class="section contact" id="contacto">
  <div class="wrap contact-in">
    <div class="contact-copy">
      <span class="eyebrow reveal">{d.contact.eyebrow}</span>
      <h2 class="title reveal" data-delay="1">{d.contact.title}</h2>
      <p class="lead reveal" data-delay="2">{d.contact.text}</p>
      <div class="contact-cta reveal" data-delay="3">
        <a class="btn btn-primary" href={INSTAGRAM_DM_URL} target="_blank" rel="noopener"><Fragment set:html={igIcon} /> {d.nav.order}</a>
        <a class="btn btn-ghost" href={INSTAGRAM_URL} target="_blank" rel="noopener">{d.contact.igCta}</a>
      </div>
      <ul class="contact-meta reveal" data-delay="4">
        <li>📍 {d.contact.location}</li>
        <li>🕰 {d.contact.hours}</li>
        <li>@alhambrasoap</li>
      </ul>
    </div>
    <div class="contact-card reveal" data-delay="2">
      <a class="qr polaroid" href={INSTAGRAM_URL} target="_blank" rel="noopener">
        <Picture src={photo('instagram-qr.jpg')} alt={d.photos.qr} widths={[300, 600]} sizes="280px" formats={formats} loading="lazy" />
        <span class="hand qr-hand" aria-hidden="true">{hand.qr} ↓</span>
        <span class="qr-cap">{d.photos.qrCaption}</span>
      </a>
    </div>
  </div>
</section>

<style>
  :global(picture) { display: block; }
  :global(picture img) { width: 100%; height: auto; display: block; }

  /* ── Hero ── */
  .hero { position: relative; overflow: hidden; background: linear-gradient(180deg, var(--ivory) 0%, var(--ivory-2) 100%); }
  .hero::after { content: ''; position: absolute; inset: auto -20% -40% auto; width: 60vw; height: 60vw; border-radius: 50%; background: radial-gradient(closest-side, rgba(197, 162, 75, 0.2), transparent); pointer-events: none; }
  .hero-in { position: relative; display: grid; gap: 3rem; padding-block: clamp(3rem, 7vw, 6rem) clamp(4rem, 8vw, 7rem); align-items: center; }
  .hero-title { font-size: clamp(2.8rem, 7.2vw, 5.4rem); line-height: 0.98; margin-block: 1.2rem 1.6rem; color: var(--cobalt-deep); }
  .hero-title > span { display: block; overflow: hidden; }
  .hero-title .it { font-style: italic; font-weight: 400; color: var(--cobalt); }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 2rem; }
  .hero-el { animation: rise 0.9s var(--ease) both; animation-delay: calc(var(--i) * 90ms); }
  @keyframes rise { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
  .hero-art { position: relative; justify-self: center; width: min(100%, 540px); padding-bottom: 2.5rem; }
  .hero-photo { margin: 0; transform: rotate(-2.5deg); }
  .hero-note { position: absolute; left: -2%; bottom: -1.9rem; display: flex; align-items: flex-end; gap: 0.2rem; pointer-events: none; }
  .hero-note .hand { font-size: 1.6rem; transform: rotate(-5deg); }
  :global(.hero-arrow) { width: 80px; height: 40px; transform: rotate(-35deg) translate(6px, -6px); }
  @media (min-width: 900px) {
    .hero-in { grid-template-columns: 1.1fr 0.9fr; gap: 4rem; }
    .hero-title { margin-block: 1.4rem 1.8rem; }
  }

  /* ── Story ── */
  .story { background: var(--ivory); }
  .story-in { display: grid; gap: 3.5rem; align-items: center; }
  .story-copy .title { margin-block: 1rem 1.5rem; }
  .story-copy .lead + .lead { margin-top: 1rem; }
  .facts { display: flex; flex-wrap: wrap; gap: 2.2rem; margin-top: 2.2rem; }
  .facts li { display: grid; }
  .facts strong { font-family: var(--font-display); font-weight: 500; font-size: 2.6rem; color: var(--cobalt); line-height: 1; }
  .facts span { font-size: 0.75rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold-3); margin-top: 0.3rem; }
  .quote { margin: 2.2rem 0 0; padding-left: 1.25rem; border-left: 2px solid var(--gold); font-family: var(--font-display); font-style: italic; font-size: 1.45rem; color: var(--ink-soft); }
  .signoff { display: flex; align-items: center; gap: 1.1rem; margin-top: 2.2rem; }
  .signoff > div { display: grid; gap: 0.15rem; }
  .portrait { width: 80px; height: 80px; border-radius: 50%; overflow: hidden; flex: none; box-shadow: 0 0 0 3px var(--ivory), 0 0 0 4px var(--gold); }
  .portrait :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .role { font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--gold-3); font-weight: 700; }

  .arch { position: relative; width: min(100%, 420px); aspect-ratio: 3 / 4; justify-self: center; }
  .arch-inner { position: absolute; inset: 0; overflow: hidden; border-radius: 50% 50% 4px 4px / 42% 42% 4px 4px; background: var(--marble); box-shadow: 0 24px 50px -24px rgba(16, 28, 79, 0.5); }
  .arch-inner :global(picture), .arch-inner :global(img) { height: 100%; }
  .arch-inner :global(img) { object-fit: cover; object-position: 30% 45%; }
  .arch-frame { position: absolute; inset: -3% -3% -2%; border: 1.5px solid var(--gold); border-radius: 50% 50% 4px 4px / 42% 42% 4px 4px; pointer-events: none; }
  .arch-frame::after { content: ''; position: absolute; inset: 10px; border: 1px solid rgba(197, 162, 75, 0.4); border-radius: inherit; }
  .arch-cap { position: absolute; left: 50%; bottom: -2.6rem; transform: translateX(-50%) rotate(-3deg); white-space: nowrap; }
  @media (min-width: 900px) { .story-in { grid-template-columns: 0.85fr 1.15fr; gap: 5rem; } }

  /* ── Collection ── */
  .collection { background: var(--ivory-2); position: relative; overflow: hidden; }
  .sec-head { max-width: 62ch; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .sec-head .title { margin-block: 1rem 1.2rem; }
  .sec-head.center { margin-inline: auto; text-align: center; }
  .sec-head.center .eyebrow { justify-content: center; }
  .products { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); position: relative; }
  .product { background: #fffdf8; border: 1px solid rgba(20, 32, 63, 0.08); border-radius: 6px; padding: 10px; box-shadow: 0 14px 30px -20px rgba(16, 28, 79, 0.35); transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease); }
  .product:hover { transform: translateY(-5px); box-shadow: 0 30px 60px -30px rgba(16, 28, 79, 0.45); }
  .product-art { aspect-ratio: 1; overflow: hidden; background: var(--marble); }
  .product-art :global(picture), .product-art :global(img) { height: 100%; }
  .product-art :global(img) { object-fit: cover; transition: transform 0.8s var(--ease); }
  .product:hover .product-art :global(img) { transform: scale(1.02); }
  .product-body { padding: 1.3rem 0.6rem 0.9rem; position: relative; }
  .product-idx { position: absolute; right: 0.6rem; top: 1rem; font-family: var(--font-display); color: var(--gold); font-size: 1rem; font-style: italic; }
  .product-body h3 { font-size: 1.55rem; color: var(--cobalt-deep); padding-right: 2rem; }
  .product-body p { color: var(--ink-soft); font-size: 0.95rem; margin-top: 0.4rem; }
  .product-note { display: inline-block; margin-top: 0.9rem; font-size: 0.7rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--gold-3); }

  .giftbox { margin-top: 3rem; display: grid; gap: 2rem; align-items: center; background: var(--cobalt-deep); color: var(--ivory); border-radius: 12px; padding: clamp(1.75rem, 4vw, 3.5rem); position: relative; overflow: hidden; }
  .giftbox::before { content: ''; position: absolute; inset: 0; background: radial-gradient(60% 100% at 100% 100%, rgba(197, 162, 75, 0.25), transparent 60%); }
  .giftbox-copy { position: relative; }
  .giftbox .tag { display: block; font-size: 0.7rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--gold-2); }
  .giftbox h3 { font-size: clamp(2rem, 4vw, 3rem); margin-block: 0.6rem 0.8rem; }
  .giftbox p { color: rgba(247, 242, 232, 0.8); max-width: 48ch; margin-bottom: 1.6rem; }
  .giftbox-art { position: relative; display: grid; place-items: center; }
  .giftbox-polaroid { width: min(100%, 340px); margin: 0; transform: rotate(-3deg); }
  .giftbox-polaroid .cap { color: var(--terracotta); }
  @media (min-width: 900px) { .giftbox { grid-template-columns: 0.9fr 1.1fr; gap: 3rem; } }
  .price-note { margin-top: 1.6rem; text-align: center; color: var(--ink-soft); font-style: italic; font-family: var(--font-display); font-size: 1.1rem; }

  .gallery-head { margin-top: clamp(3rem, 6vw, 5rem); margin-bottom: 1.6rem; }
  .gallery-head h3 { font-size: clamp(1.7rem, 3vw, 2.4rem); margin-top: 0.6rem; }
  .gallery-hand { display: inline-block; margin-left: 0.6rem; transform: rotate(-3deg) translateY(-4px); font-size: 1.5rem; }
  .gallery { display: grid; gap: 1.6rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); position: relative; max-width: 900px; }
  .gallery li { transform: rotate(var(--rot)); transition: transform 0.6s var(--ease); }
  .gallery li:hover { transform: rotate(0deg) translateY(-6px) scale(1.03); z-index: 2; }
  .gallery :global(img) { aspect-ratio: 1; object-fit: cover; }
  .gallery .cap { font-size: 1.25rem; color: var(--ink-soft); }

  /* ── Workshops ── */
  .workshops { background: var(--ivory); }
  .ws-grid { display: grid; gap: 3rem; align-items: start; }
  .ws-copy .title { margin-block: 1rem 1.2rem; }
  .ws-detail { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-block: 1.6rem 2rem; }
  .ws-detail li { font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 700; padding: 0.5rem 0.9rem; border: 1px solid rgba(197, 162, 75, 0.6); border-radius: 999px; color: var(--gold-3); }
  .ws-cta { display: flex; align-items: center; flex-wrap: wrap; gap: 1rem 1.4rem; }
  .ws-hand { transform: rotate(-4deg); color: var(--terracotta); }
  .steps { display: grid; gap: 0; }
  .step { display: grid; grid-template-columns: auto 1fr; gap: 1.3rem; padding: 1.6rem 0; border-top: 1px solid rgba(20, 32, 63, 0.1); }
  .step:last-child { border-bottom: 1px solid rgba(20, 32, 63, 0.1); }
  .step-n { width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; font-family: var(--font-display); font-size: 1.5rem; color: var(--gold-2); background: var(--cobalt-deep); }
  .step h3 { font-size: 1.7rem; color: var(--cobalt-deep); }
  .step p { color: var(--ink-soft); margin-top: 0.2rem; }
