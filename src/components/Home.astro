---
import Tile from './Tile.astro';
import Pattern from './Pattern.astro';
import Logo from './Logo.astro';
import { t, withBase, INSTAGRAM_URL, INSTAGRAM_DM_URL, INSTAGRAM_HIGHLIGHTS, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const img = (f: string) => withBase(`/images/${f}`);
const productPhotos = [
  { src: 'estrella-de-los-reyes.jpg', alt: { es: 'Jabón octogonal Estrella de los Reyes, estrella azul con centro ocre', en: 'Octagonal Estrella de los Reyes soap, blue star with ochre centre' } },
  { src: 'pajaritas.jpg', alt: { es: 'Jabón hexagonal Pajaritas con pajaritas nazaríes azules, verdes, ocres y negras', en: 'Hexagonal Pajaritas soap with blue, green, ochre and black Nasrid birds' } },
  { src: 'jabonera.jpg', alt: { es: 'Jabonera redonda de Alhambra Soap sobre terciopelo azul', en: 'Round Alhambra Soap dish on blue velvet' } },
];
const igIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>`;
const arrow = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`;
---

<!-- ───────────────────────── HERO ───────────────────────── -->
<section class="hero">
  <Pattern id="p-hero" opacity={0.12} />
  <div class="wrap hero-in">
    <div class="hero-copy">
      <span class="eyebrow hero-el" style="--i:0">{d.hero.eyebrow}</span>
      <h1 class="hero-title">
        {d.hero.title.map((line, i) => <span class="hero-el" style={`--i:${i + 1}`}><span class:list={[{ it: i === 2 }]}>{line}</span></span>)}
      </h1>
      <p class="lead hero-el" style="--i:4">{d.hero.lead}</p>
      <div class="hero-cta hero-el" style="--i:5">
        <a class="btn btn-primary" href="#coleccion">{d.hero.cta} <Fragment set:html={arrow} /></a>
        <a class="btn btn-ghost" href={INSTAGRAM_DM_URL} target="_blank" rel="noopener"><Fragment set:html={igIcon} /> {d.hero.ctaSecondary}</a>
      </div>
    </div>

    <div class="hero-art hero-el" style="--i:2">
      <figure class="hero-photo">
        <img src={img('ritual-caja-abierta.jpg')} alt={d.photos.hero} width="1000" height="1024" fetchpriority="high" />
      </figure>
      <div class="badge">
        <svg viewBox="0 0 100 100" class="badge-ring">
          <defs><path id="ring" d="M50 50 m-38 0 a38 38 0 1 1 76 0 a38 38 0 1 1 -76 0"/></defs>
          <text font-size="9.5" letter-spacing="2.6" fill="var(--cobalt-deep)" font-family="Karla, sans-serif" font-weight="700">
            <textPath href="#ring">{d.hero.badge[2].toUpperCase()} · {d.hero.badge[0].toUpperCase()} {d.hero.badge[1].toUpperCase()} · </textPath>
          </text>
        </svg>
        <Logo size={34} wordmark={false} color="var(--cobalt-deep)" />
      </div>
    </div>
  </div>
</section>

<!-- ───────────────────────── MARQUEE ───────────────────────── -->
<div class="marquee" aria-hidden="true">
  <div class="track">
    {[0, 1].map(() => d.marquee.map((m) => <span>{m}<i>✦</i></span>))}
  </div>
</div>

<!-- ───────────────────────── STORY ───────────────────────── -->
<section class="section story" id="historia">
  <div class="wrap story-in">
    <div class="arch reveal">
      <div class="arch-inner">
        <img src={img('estrella-ocho-puntas.jpg')} alt={d.photos.story} loading="lazy" width="900" height="822" />
      </div>
      <div class="arch-frame"></div>
    </div>
    <div class="story-copy">
      <span class="eyebrow reveal">{d.story.eyebrow}</span>
      <h2 class="title reveal" data-delay="1">{d.story.title}</h2>
      <p class="lead reveal" data-delay="2">{d.story.p1}</p>
      <p class="lead reveal" data-delay="3">{d.story.p2}</p>
      <ul class="facts reveal" data-delay="4">
        {d.story.facts.map((f) => (
          <li><strong>{f.n}</strong><span>{f.label}</span></li>
        ))}
      </ul>
      <blockquote class="quote reveal" data-delay="4">{d.story.quote}</blockquote>
    </div>
  </div>
</section>

<!-- ───────────────────────── COLLECTION ───────────────────────── -->
<section class="section collection" id="coleccion">
  <Pattern id="p-col" opacity={0.08} color="#1d2f7c" />
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow reveal">{d.collection.eyebrow}</span>
      <h2 class="title reveal" data-delay="1">{d.collection.title}</h2>
      <p class="lead reveal" data-delay="2">{d.collection.intro}</p>
    </div>

    <ul class="products">
      {d.collection.items.map((item, i) => (
        <li class="product reveal" data-delay={String((i % 4) + 1)}>
          <div class="product-art">
            <img src={img(productPhotos[i].src)} alt={productPhotos[i].alt[lang]} loading="lazy" width="900" height="900" />
          </div>
          <div class="product-body">
            <span class="product-idx">0{i + 1}</span>
            <h3>{item.name}</h3>
            <p>{item.desc}</p>
            <span class="product-note">{item.note}</span>
          </div>
        </li>
      ))}
    </ul>

    <div class="giftbox reveal">
      <div class="giftbox-art">
        <img src={img('ritual-caja-cerrada.jpg')} alt={d.photos.box} loading="lazy" width="738" height="1110" />
      </div>
      <div class="giftbox-copy">
        <span class="tag">{d.collection.giftBox.tag}</span>
        <h3>{d.collection.giftBox.name}</h3>
        <p>{d.collection.giftBox.desc}</p>
        <a class="btn btn-gold" href={INSTAGRAM_DM_URL} target="_blank" rel="noopener">{d.collection.giftBox.cta} <Fragment set:html={arrow} /></a>
      </div>
    </div>

    <p class="price-note reveal">{d.collection.priceNote}</p>

    <div class="gallery-head">
      <span class="eyebrow reveal">{d.gallery.eyebrow}</span>
      <h3 class="reveal" data-delay="1">{d.gallery.title}</h3>
    </div>
    <ul class="gallery">
      {d.gallery.items.map((g, i) => (
        <li class="reveal" data-delay={String((i % 4) + 1)}>
          <img src={img(g.img)} alt={g.caption} loading="lazy" width="900" height="900" />
          <span>{g.caption}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- ───────────────────────── WORKSHOPS ───────────────────────── -->
<section class="section workshops" id="talleres">
  <div class="wrap">
    <div class="ws-grid">
      <div class="ws-copy">
        <span class="eyebrow reveal">{d.workshops.eyebrow}</span>
        <h2 class="title reveal" data-delay="1">{d.workshops.title}</h2>
        <p class="lead reveal" data-delay="2">{d.workshops.intro}</p>
        <ul class="ws-detail reveal" data-delay="3">
          {d.workshops.detail.map((x) => <li>{x}</li>)}
        </ul>
        <a class="btn btn-primary reveal" data-delay="4" href={INSTAGRAM_DM_URL} target="_blank" rel="noopener">{d.workshops.cta} <Fragment set:html={arrow} /></a>
      </div>
      <ol class="steps">
        {d.workshops.steps.map((s, i) => (
          <li class="step reveal" data-delay={String(i + 1)}>
            <span class="step-n">{i + 1}</span>
            <div>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<!-- ───────────────────────── TEACHER GIFTS ───────────────────────── -->
<section class="gifts" id="regalos">
  <Pattern id="p-gift" opacity={0.18} color="#e3c878" />
  <div class="wrap gifts-in">
    <div class="gifts-tile reveal" aria-hidden="true"><Tile variant="pajaritas" size="100%" /></div>
    <div class="gifts-copy">
      <span class="eyebrow light reveal">{d.gifts.eyebrow}</span>
      <h2 class="title reveal" data-delay="1">{d.gifts.title}</h2>
      <p class="reveal" data-delay="2">{d.gifts.text}</p>
      <a class="btn btn-gold reveal" data-delay="3" href={INSTAGRAM_DM_URL} target="_blank" rel="noopener"><Fragment set:html={igIcon} /> {d.gifts.cta}</a>
    </div>
  </div>
  <div class="wrap">
    <ul class="gifts-more">
      {d.gifts.more.map((g, i) => (
        <li class="reveal" data-delay={String(i + 1)}>
          <h3>{g.t}</h3>
          <p>{g.d}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- ───────────────────────── TESTIMONIALS ───────────────────────── -->
<section class="section testimonials">
  <div class="wrap">
    <div class="sec-head center">
      <span class="eyebrow reveal">{d.testimonials.eyebrow}</span>
      <h2 class="title reveal" data-delay="1">{d.testimonials.title}</h2>
    </div>
    <ul class="quotes">
      {d.testimonials.items.map((q, i) => (
        <li class="q reveal" data-delay={String(i + 1)}>
          <span class="q-mark">“</span>
          <p>{q.q}</p>
          <cite>{q.a}</cite>
        </li>
      ))}
    </ul>
    <p class="t-source reveal">
      <span>{d.testimonials.source}</span>
      <a href={INSTAGRAM_HIGHLIGHTS.testimonios} target="_blank" rel="noopener">{d.testimonials.more} <Fragment set:html={arrow} /></a>
    </p>
  </div>
</section>

<!-- ───────────────────────── PRESS ───────────────────────── -->
<section class="press">
  <div class="wrap">
    <div class="ornament reveal"><span class="eyebrow" style="color:var(--gold-3)">{d.press.eyebrow}</span></div>
    <ul class="press-list reveal" data-delay="1">
      {d.press.items.map((p) => <li>{p}</li>)}
      <li class="press-link"><a href={INSTAGRAM_HIGHLIGHTS.prensa} target="_blank" rel="noopener">{d.press.more} <Fragment set:html={arrow} /></a></li>
    </ul>
  </div>
</section>

<!-- ───────────────────────── CONTACT ───────────────────────── -->
<section class="section contact" id="contacto">
  <div class="wrap contact-in">
    <div class="contact-copy">
      <span class="eyebrow reveal">{d.contact.eyebrow}</span>
      <h2 class="title reveal" data-delay="1">{d.contact.title}</h2>
      <p class="lead reveal" data-delay="2">{d.contact.text}</p>
      <div class="contact-cta reveal" data-delay="3">
        <a class="btn btn-primary" href={INSTAGRAM_DM_URL} target="_blank" rel="noopener"><Fragment set:html={igIcon} /> {d.nav.order}</a>
        <a class="btn btn-ghost" href={INSTAGRAM_URL} target="_blank" rel="noopener">{d.contact.igCta}</a>
      </div>
      <ul class="contact-meta reveal" data-delay="4">
        <li>📍 {d.contact.location}</li>
        <li>🕰 {d.contact.hours}</li>
        <li>@alhambrasoap</li>
      </ul>
    </div>
    <div class="contact-card reveal" data-delay="2">
      <a class="qr" href={INSTAGRAM_URL} target="_blank" rel="noopener">
        <img src={img('instagram-qr.jpg')} alt={d.photos.qr} loading="lazy" width="700" height="671" />
        <span>{d.photos.qrCaption}</span>
      </a>
    </div>
  </div>
</section>

<style>
  /* ── Hero ── */
  .hero { position: relative; overflow: hidden; background: linear-gradient(180deg, var(--ivory) 0%, var(--ivory-2) 100%); }
  .hero::after { content: ''; position: absolute; inset: auto -20% -40% auto; width: 60vw; height: 60vw; border-radius: 50%; background: radial-gradient(closest-side, rgba(197, 162, 75, 0.22), transparent); pointer-events: none; }
  .hero-in { position: relative; display: grid; gap: 3rem; padding-block: clamp(3rem, 7vw, 6rem) clamp(4rem, 8vw, 7rem); align-items: center; }
  .hero-title { font-size: clamp(2.8rem, 7.2vw, 5.4rem); line-height: 0.98; margin-block: 1.2rem 1.6rem; color: var(--cobalt-deep); }
  .hero-title > span { display: block; overflow: hidden; }
  .hero-title .it { font-style: italic; font-weight: 400; color: var(--cobalt); }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 2rem; }
  .hero-el { animation: rise 1.1s var(--ease) both; animation-delay: calc(var(--i) * 110ms); }
  @keyframes rise { from { opacity: 0; transform: translateY(26px); } to { opacity: 1; transform: none; } }

  .hero-art { position: relative; justify-self: center; width: min(100%, 540px); }
  .hero-photo { margin: 0; transform: rotate(-2.5deg); border-radius: 6px; overflow: hidden; box-shadow: 0 40px 80px -30px rgba(16, 28, 79, 0.6), 0 0 0 1px rgba(20, 32, 63, 0.06); background: var(--cobalt-deep); }
  .hero-photo img { width: 100%; height: auto; display: block; transition: transform 1.2s var(--ease); }
  .hero-photo:hover img { transform: scale(1.03); }
  @keyframes float { 0%, 100% { transform: translateY(0) rotate(-2deg); } 50% { transform: translateY(-8px) rotate(2deg); } }
  .badge { position: absolute; right: -2%; top: -4%; width: 128px; height: 128px; display: grid; place-items: center; background: var(--gold-2); border-radius: 50%; box-shadow: 0 16px 40px -18px rgba(0, 0, 0, 0.5); }
  .badge-ring { position: absolute; inset: 0; width: 100%; height: 100%; animation: spin 24s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }

  @media (min-width: 900px) {
    .hero-in { grid-template-columns: 1.1fr 0.9fr; gap: 4rem; }
    .hero-title { margin-block: 1.4rem 1.8rem; }
  }

  /* ── Marquee ── */
  .marquee { background: var(--cobalt-deep); color: var(--gold-2); overflow: hidden; padding-block: 0.9rem; border-block: 1px solid rgba(227, 200, 120, 0.25); }
  .track { display: flex; width: max-content; animation: slide 36s linear infinite; }
  .track span { display: inline-flex; align-items: center; gap: 1.5rem; padding-inline: 0.75rem 1.5rem; font-family: var(--font-display); font-size: 1.15rem; letter-spacing: 0.08em; text-transform: uppercase; white-space: nowrap; }
  .track i { font-style: normal; font-size: 0.7rem; color: var(--gold); }
  @keyframes slide { to { transform: translateX(-50%); } }

  /* ── Story ── */
  .story { background: var(--ivory); }
  .story-in { display: grid; gap: 3rem; align-items: center; }
  .story-copy .title { margin-block: 1rem 1.5rem; }
  .story-copy .lead + .lead { margin-top: 1rem; }
  .facts { display: flex; flex-wrap: wrap; gap: 2.2rem; margin-top: 2.2rem; }
  .facts li { display: grid; }
  .facts strong { font-family: var(--font-display); font-weight: 500; font-size: 2.6rem; color: var(--cobalt); line-height: 1; }
  .facts span { font-size: 0.75rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold-3); margin-top: 0.3rem; }
  .quote { margin: 2.2rem 0 0; padding-left: 1.25rem; border-left: 2px solid var(--gold); font-family: var(--font-display); font-style: italic; font-size: 1.45rem; color: var(--ink-soft); }

  .arch { position: relative; width: min(100%, 420px); aspect-ratio: 3 / 4; justify-self: center; }
  .arch-inner { position: absolute; inset: 0; overflow: hidden; border-radius: 50% 50% 4px 4px / 42% 42% 4px 4px; background: var(--marble); }
  .arch-inner img { width: 100%; height: 100%; object-fit: cover; object-position: 30% 45%; transition: transform 1.4s var(--ease); }
  .arch:hover .arch-inner img { transform: scale(1.04); }
  .arch-frame { position: absolute; inset: -3% -3% -2%; border: 1.5px solid var(--gold); border-radius: 50% 50% 4px 4px / 42% 42% 4px 4px; pointer-events: none; }
  .arch-frame::after { content: ''; position: absolute; inset: 10px; border: 1px solid rgba(197, 162, 75, 0.4); border-radius: inherit; }
  @media (min-width: 900px) { .story-in { grid-template-columns: 0.85fr 1.15fr; gap: 5rem; } }

  /* ── Collection ── */
  .collection { background: var(--ivory-2); overflow: hidden; }
  .sec-head { max-width: 62ch; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .sec-head .title { margin-block: 1rem 1.2rem; }
  .sec-head.center { margin-inline: auto; text-align: center; }
  .sec-head.center .eyebrow { justify-content: center; }
  .products { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); position: relative; }
  .product { background: var(--ivory); border: 1px solid rgba(20, 32, 63, 0.08); border-radius: 10px; overflow: hidden; transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease); }
  .product:hover { transform: translateY(-6px); box-shadow: 0 30px 60px -30px rgba(16, 28, 79, 0.45); }
  .product-art { aspect-ratio: 1; overflow: hidden; background: var(--marble); }
  .product-art img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s var(--ease); }
  .product:hover .product-art img { transform: scale(1.05); }
  .product-body { padding: 1.3rem 1.4rem 1.5rem; position: relative; }
  .product-idx { position: absolute; right: 1.2rem; top: 1rem; font-family: var(--font-display); color: var(--gold); font-size: 1rem; font-style: italic; }
  .product-body h3 { font-size: 1.55rem; color: var(--cobalt-deep); padding-right: 2rem; }
  .product-body p { color: var(--ink-soft); font-size: 0.95rem; margin-top: 0.4rem; }
  .product-note { display: inline-block; margin-top: 0.9rem; font-size: 0.7rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--gold-3); }

  .giftbox { margin-top: 3rem; display: grid; gap: 2rem; align-items: center; background: var(--cobalt-deep); color: var(--ivory); border-radius: 12px; padding: clamp(1.75rem, 4vw, 3.5rem); position: relative; overflow: hidden; }
  .giftbox::before { content: ''; position: absolute; inset: 0; background: radial-gradient(60% 100% at 100% 100%, rgba(197, 162, 75, 0.25), transparent 60%); }
  .giftbox-copy { position: relative; }
  .giftbox .tag { font-size: 0.7rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--gold-2); }
  .giftbox h3 { font-size: clamp(2rem, 4vw, 3rem); margin-block: 0.6rem 0.8rem; }
  .giftbox p { color: rgba(247, 242, 232, 0.8); max-width: 48ch; margin-bottom: 1.6rem; }
  .giftbox-art { position: relative; display: grid; place-items: center; }
  .giftbox-art img { width: min(100%, 360px); height: auto; border-radius: 6px; transform: rotate(-3deg); box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.6); }
  @media (min-width: 900px) { .giftbox { grid-template-columns: 0.9fr 1.1fr; gap: 3rem; } }
  .gallery-head { margin-top: clamp(3rem, 6vw, 5rem); margin-bottom: 1.6rem; }
  .gallery-head h3 { font-size: clamp(1.7rem, 3vw, 2.4rem); margin-top: 0.6rem; }
  .gallery { display: grid; gap: 1rem; grid-template-columns: repeat(2, 1fr); position: relative; }
  .gallery li { display: grid; gap: 0.6rem; }
  .gallery img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: 8px; border: 1px solid rgba(20, 32, 63, 0.08); transition: transform 0.6s var(--ease); }
  .gallery li:hover img { transform: translateY(-4px); }
  .gallery span { font-size: 0.8rem; color: var(--ink-soft); font-style: italic; font-family: var(--font-display); font-size: 1.02rem; }
  @media (min-width: 760px) { .gallery { grid-template-columns: repeat(4, 1fr); } }
  .price-note { margin-top: 1.6rem; text-align: center; font-size: 0.85rem; color: var(--ink-soft); font-style: italic; font-family: var(--font-display); font-size: 1.1rem; }

  /* ── Workshops ── */
  .workshops { background: var(--ivory); }
  .ws-grid { display: grid; gap: 3rem; align-items: start; }
  .ws-copy .title { margin-block: 1rem 1.2rem; }
  .ws-detail { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-block: 1.6rem 2rem; }
  .ws-detail li { font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 700; padding: 0.5rem 0.9rem; border: 1px solid rgba(197, 162, 75, 0.6); border-radius: 999px; color: var(--gold-3); }
  .steps { display: grid; gap: 0; counter-reset: s; }
  .step { display: grid; grid-template-columns: auto 1fr; gap: 1.3rem; padding: 1.6rem 0; border-top: 1px solid rgba(20, 32, 63, 0.1); }
  .step:last-child { border-bottom: 1px solid rgba(20, 32, 63, 0.1); }
  .step-n { width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; font-family: var(--font-display); font-size: 1.5rem; color: var(--gold-2); background: var(--cobalt-deep); }
  .step h3 { font-size: 1.7rem; color: var(--cobalt-deep); }
  .step p { color: var(--ink-soft); margin-top: 0.2rem; }
  @media (min-width: 900px) { .ws-grid { grid-template-columns: 1fr 1fr; gap: 5rem; } }

  /* ── Gifts ── */
  .gifts { position: relative; overflow: hidden; background: linear-gradient(135deg, #22368a 0%, #101c4f 70%); color: var(--ivory); padding-block: clamp(4rem, 8vw, 7rem); }
  .gifts-in { position: relative; display: grid; gap: 2.5rem; align-items: center; }
  .gifts-tile { width: min(60%, 280px); justify-self: center; animation: float 9s ease-in-out infinite; }
  .gifts .eyebrow.light { color: var(--gold-2); }
  .gifts .eyebrow.light::before { background: var(--gold-2); }
  .gifts .title { margin-block: 1rem 1.2rem; color: var(--ivory); }
  .gifts p { color: rgba(247, 242, 232, 0.82); max-width: 52ch; margin-bottom: 1.8rem; }
  @media (min-width: 900px) { .gifts-in { grid-template-columns: 0.7fr 1.3fr; gap: 4rem; } }
  .gifts-more { position: relative; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); margin-top: 3.5rem; padding-top: 2.5rem; border-top: 1px solid rgba(227, 200, 120, 0.25); }
  .gifts-more li { padding: 1.4rem 1.5rem; border: 1px solid rgba(227, 200, 120, 0.3); border-radius: 10px; background: rgba(255, 255, 255, 0.04); }
  .gifts-more h3 { font-size: 1.5rem; color: var(--gold-2); }
  .gifts-more p { font-size: 0.92rem; margin: 0.4rem 0 0; }

  /* ── Testimonials ── */
  .testimonials { background: var(--ivory-2); }
