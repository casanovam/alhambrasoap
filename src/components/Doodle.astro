---
/** Hand-drawn SVG doodles: arrow | jasmine | underline | circle | sparkle */
interface Props { kind: 'arrow' | 'jasmine' | 'underline' | 'circle' | 'sparkle'; class?: string; color?: string }
const { kind, class: cls = '', color = 'currentColor' } = Astro.props;
const stroke = { fill: 'none', stroke: color, 'stroke-width': 2.2, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' } as const;
---
{kind === 'arrow' && (
  <svg class={`doodle ${cls}`} viewBox="0 0 120 60" aria-hidden="true">
    <path {...stroke} d="M4 44 C 28 12, 62 8, 104 26" />
    <path {...stroke} d="M94 14 C 99 20, 103 24, 106 27 C 100 28, 95 31, 90 36" />
  </svg>
)}
{kind === 'jasmine' && (
  <svg class={`doodle ${cls}`} viewBox="0 0 120 120" aria-hidden="true">
    <path {...stroke} d="M18 104 C 40 84, 56 62, 72 40" />
    <path {...stroke} d="M42 76 C 30 70, 22 74, 16 82 C 26 84, 36 84, 42 76 Z" />
    <path {...stroke} d="M56 58 C 62 44, 58 34, 50 30 C 46 42, 48 52, 56 58 Z" />
    <g {...stroke} stroke-width="1.8">
      <path d="M78 34 C 78 26, 86 24, 88 30 C 94 26, 100 32, 96 38 C 102 42, 96 50, 90 46 C 88 54, 78 52, 78 46 C 70 48, 68 38, 74 36 C 70 30, 76 26, 78 34 Z" />
      <circle cx="86" cy="39" r="2.5" fill={color} stroke="none" />
    </g>
    <path {...stroke} stroke-width="1.6" d="M96 18 C 100 12, 106 12, 106 18" />
    <circle cx="110" cy="26" r="1.6" fill={color} stroke="none" />
  </svg>
)}
{kind === 'underline' && (
  <svg class={`doodle ${cls}`} viewBox="0 0 240 16" preserveAspectRatio="none" aria-hidden="true">
    <path {...stroke} d="M3 9 C 40 4, 80 12, 120 7 S 200 4, 237 9" />
    <path {...stroke} stroke-width="1.4" opacity=".6" d="M8 13 C 60 9, 120 14, 180 10 S 220 9, 232 12" />
  </svg>
)}
{kind === 'circle' && (
  <svg class={`doodle ${cls}`} viewBox="0 0 100 100" aria-hidden="true">
    <path {...stroke} d="M50 7 C 76 4, 96 24, 94 50 C 92 78, 70 96, 46 93 C 20 90, 4 70, 8 46 C 12 22, 28 8, 50 7" />
    <path {...stroke} stroke-width="1.5" opacity=".55" d="M46 10 C 70 8, 90 26, 90 48 C 90 74, 70 90, 48 90" />
  </svg>
)}
{kind === 'sparkle' && (
  <svg class={`doodle ${cls}`} viewBox="0 0 40 40" aria-hidden="true">
    <path {...stroke} d="M20 4 C 21 14, 26 19, 36 20 C 26 21, 21 26, 20 36 C 19 26, 14 21, 4 20 C 14 19, 19 14, 20 4 Z" />
  </svg>
)}
<style>
  .doodle { display: block; pointer-events: none; }
</style>
