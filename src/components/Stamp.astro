---
/** Rubber-stamp seal with eroded ink. */
import Logo from './Logo.astro';
interface Props { text: string; color?: string; size?: number; class?: string }
const { text, color = '#b7452a', size = 130, class: cls = '' } = Astro.props;
const id = `stamp-${Math.random().toString(36).slice(2, 7)}`;
---
<span class={`stamp ${cls}`} style={`--s:${size}px; --c:${color}`} aria-hidden="true">
  <svg viewBox="0 0 100 100" width={size} height={size}>
    <defs>
      <path id={`${id}-ring`} d="M50 50 m-36 0 a36 36 0 1 1 72 0 a36 36 0 1 1 -72 0" />
      <filter id={`${id}-grain`} x="0" y="0" width="100%" height="100%">
        <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" seed="5" />
        <feComponentTransfer>
          <feFuncR type="linear" slope="2.6" intercept="-0.35" />
          <feFuncG type="linear" slope="2.6" intercept="-0.35" />
          <feFuncB type="linear" slope="2.6" intercept="-0.35" />
          <feFuncA type="discrete" tableValues="1" />
        </feComponentTransfer>
      </filter>
      <mask id={`${id}-mask`} maskUnits="userSpaceOnUse" x="0" y="0" width="100" height="100">
        <rect width="100" height="100" fill="#fff" filter={`url(#${id}-grain)`} />
      </mask>
    </defs>
    <g mask={`url(#${id}-mask)`} fill="none" stroke="var(--c)">
      <circle cx="50" cy="50" r="46" stroke-width="2.6" />
      <circle cx="50" cy="50" r="42.5" stroke-width="0.9" />
      <circle cx="50" cy="50" r="27" stroke-width="1.2" />
      <text font-size="8.6" letter-spacing="2.4" fill="var(--c)" stroke="none" font-family="Karla, sans-serif" font-weight="700">
        <textPath href={`#${id}-ring`} startOffset="0">{text.toUpperCase()}</textPath>
      </text>
      <g transform="translate(31 31) scale(0.38)">
        <path d="M50 12 C 68 30, 78 50, 86 72 C 70 62, 50 60, 30 68 C 34 48, 40 28, 50 12 Z" stroke-width="5" stroke-linejoin="round" />
        <path d="M50 12 C 40 34, 32 54, 14 74 C 36 68, 58 70, 86 72" stroke-width="5" stroke-linecap="round" />
      </g>
    </g>
  </svg>
</span>
<style>
  .stamp { display: inline-block; width: var(--s); height: var(--s); opacity: 0.88; mix-blend-mode: multiply; transform: rotate(-12deg); }
  .stamp svg { display: block; }
</style>
