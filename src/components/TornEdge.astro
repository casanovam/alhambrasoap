---
/**
 * Hand-torn paper edge. Place at the top of a section; `fill` must match that
 * section's background so it bites into the section above.
 */
interface Props { fill: string; seed?: number; flip?: boolean; class?: string }
const { fill, seed = 1, flip = false, class: cls = '' } = Astro.props;
let s = seed * 9301 + 49297;
const rnd = () => { s = (s * 9301 + 49297) % 233280; return s / 233280; };
const W = 1440, H = 28, N = 110;
let d = `M0 ${H} L0 ${12 + rnd() * 10}`;
for (let i = 1; i <= N; i++) {
  const x = (i / N) * W;
  const y = 6 + rnd() * 16 + (i % 7 === 0 ? rnd() * 6 : 0);
  d += ` L${x.toFixed(1)} ${y.toFixed(1)}`;
}
d += ` L${W} ${H} Z`;
---
<svg class={`torn ${cls}`} class:list={[{ flip }]} viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
  <path d={d} fill={fill} />
  <path d={d} fill="none" stroke="rgba(20,32,63,.07)" stroke-width="1" />
</svg>
<style>
  .torn { position: absolute; left: 0; right: 0; width: 100%; height: 28px; top: -27px; display: block; pointer-events: none; z-index: 2; }
  .torn.flip { top: auto; bottom: -27px; transform: scaleY(-1); }
</style>
